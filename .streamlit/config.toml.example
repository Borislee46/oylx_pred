# 复制为 .streamlit/config.toml 后按需修改（install_ubuntu.sh 会自动生成）。
#
# 主题这一节不要删：页面样式是按暗色底设计的，用 Streamlit 默认亮色主题会显示错乱。

[theme]
base = "dark"
primaryColor = "#06b6d4"
backgroundColor = "#0b1220"
secondaryBackgroundColor = "#111a2c"
textColor = "#cbd5e1"

[server]
# 必填：用于签名会话 Cookie。留空则可被环境变量 STREAMLIT_SERVER_COOKIE_SECRET 覆盖。
# 生成：openssl rand -hex 32
cookieSecret = ""
headless = true
address = "127.0.0.1"
port = 8501
# 开源版没有 static/ 目录；若你自带了静态资源（如技术报告 HTML）再改为 true
enableStaticServing = false
maxUploadSize = 20
maxMessageSize = 50
maxWidgetStateSize = 25

# 自定义组件（lead_in_wait / probability_blocks / hk_whatif_axis）通过同源 iframe +
# postMessage 通信，不需要关掉 XSRF 保护。若部署后组件报 XSRF / CORS 错误，
# 再按需打开下面两行（理解其含义后再开，公开部署保持默认更安全）。
# enableXsrfProtection = false
# enableCORS = false

[logger]
level = "error"

[client]
showErrorDetails = false
disableDataExport = true

[browser]
gatherUsageStats = false
