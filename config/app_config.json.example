{
  "_说明": "复制为 config/app_config.json 并按需填写。未配置的字段走默认值（AI 助手关闭）。密钥严禁提交到 git。",
  "prod": {
    "STREAMLIT_APP_BASE_URL": "https://your-domain.example.com/",
    "OPEN_AI_API_KEY": "",
    "OPEN_AI_BASE_URL": "",
    "OPEN_AI_MODEL": "",
    "ENABLE_LEAD_IN_AGENT": false,
    "HARNESS_ENABLED": false,
    "HARNESS_STAGES": {
      "lead_in": "ui",
      "prediction": "ui",
      "explain": "ui"
    }
  }
}
