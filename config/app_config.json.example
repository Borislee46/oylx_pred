{
  "_说明": "复制为 config/app_config.json 并按需填写；密钥也可通过环境变量注入（OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL / GHOST_API_KEY），优先级高于本文件。密钥严禁提交到 git。",
  "prod": {
    "STREAMLIT_APP_BASE_URL": "https://your-domain.example.com/",
    "OPEN_AI_BASE_URL": "https://api.deepseek.com/v1/chat/completions",
    "OPEN_AI_MODEL": "deepseek-v4-flash",
    "OPEN_AI_API_KEY": "",
    "ENABLE_LEAD_IN_AGENT": true,
    "HARNESS_ENABLED": false,
    "HARNESS_STAGES": {
      "lead_in": "ui",
      "prediction": "ui",
      "explain": "ui"
    },
    "GHOST_API_BASE_URL": "https://api.deepseek.com/beta",
    "GHOST_API_MODEL": "deepseek-v4-flash",
    "GHOST_API_KEY": ""
  }
}
