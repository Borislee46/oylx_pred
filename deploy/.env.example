# 生产环境变量模板。install_ubuntu.sh 会自动生成 .env（权限 600），
# 请不要把真实 .env 提交到代码仓库。
DEMO_COOKIE_SECRET=change-me-64-char-random-hex
STREAMLIT_SERVER_COOKIE_SECRET=change-me-64-char-random-hex
DEMO_TRUST_PROXY=1
APP_ENV=prod
DEMO_USERS_PATH=/opt/oylx-demo/config/demo_users.json
STREAMLIT_SERVER_ADDRESS=127.0.0.1
STREAMLIT_SERVER_PORT=8501

# 个人 AI key（统一一个 key，OPENAI 与 GHOST 幽灵补全共用）
OPENAI_API_KEY=sk-你的个人key
OPENAI_BASE_URL=https://api.deepseek.com/v1/chat/completions
OPENAI_MODEL=deepseek-v4-flash
# GHOST_API_KEY 可省略，缺省复用 OPENAI_API_KEY
# GHOST_API_KEY=sk-你的个人key
GHOST_API_BASE_URL=https://api.deepseek.com/beta
GHOST_API_MODEL=deepseek-v4-flash
