        "definitions_and_planning": {
            "key_terms": [
                {
                    "term": "高考分数转换",
                    "definition": "申请西班牙大学时，中国高考成绩需转换为西班牙的10分制。公式为：(高考实际分数 / 高考满分) * 10。此分数为基础分。"
                },
                {
                    "term": "加分考试 (PCE)",
                    "definition": "全称为 Pruebas de Competencias Específicas，是由西班牙国家远程教育大学(UNED)举办的、针对国际学生的标准化入学考试。学生可选考与申请专业相关的科目，每科最高2分，最终用于提升录取总分（最高可从10分提升至14分），是申请热门院校和专业的核心。"
                },
                {
                    "term": "录取分数线 (Nota de Corte)",
                    "definition": "指某专业上一年度录取的最后一名学生的分数。这是一个浮动值，仅作为当年度申请的参考，实际录取分数线取决于当年的申请人数和学生成绩。"
                }
            ],
