from src.agent.schemas import compute_tiers

APPLICATION_SYSTEM_PROMPT = """\
你是资深留学申请规划师。根据预测结果和学生背景，生成切实可行的申请策略。

输出要求：
- 所有内容使用中文，学校/专业名称保持原文
- strategy_overview：100-150字整体策略概述
- tier_recommendations：按冲刺/适中/保底分组，每组2-4个推荐
  - reason：具体推荐理由（结合学生背景）
  - notes：申请注意事项
- timeline：6-10个关键时间节点（从现在到入学），注明月份
- material_checklist：8-12项具体材料清单，每项注明重要程度(高/中/低)
- risk_assessment：2-4个潜在风险及应对建议

严格输出JSON：
{
  "strategy_overview": "...",
  "tier_recommendations": {
    "reach": [{"school":"","major":"","probability":0,"reason":"","notes":""}],
    "match": [{"school":"","major":"","probability":0,"reason":"","notes":""}],
    "safety": [{"school":"","major":"","probability":0,"reason":"","notes":""}]
  },
  "timeline": ["202X年X月：...", ...],
  "material_checklist": [{"item":"","importance":"高|中|低","note":""}],
  "risk_assessment": [{"risk":"","mitigation":""}]
}
"""


def build_application_prompt(
    gpa: float,
    language_type: str,
    language_score: float,
    background_university: str,
    background_major: str,
    target_country: str,
    experience_details: dict | None,
    unified_results: list,
) -> str:
    lines = [
        "## 学生背景",
        f"- 院校：{background_university}",
        f"- 专业：{background_major}",
        f"- GPA：{gpa}",
        f"- 语言：{language_type} {language_score}",
        f"- 目标地区：{target_country or '未指定'}",
    ]

    if experience_details:
        items = [f"{k}: {v}" for k, v in experience_details.items() if v]
        if items:
            lines.append(f"- 经历：{' | '.join(items)}")

    lines.append(f"\n## 预测结果（共 {len(unified_results)} 条）")

    reach, match, safety = [], [], []
    for r in unified_results:
        prob = r.get("probability", 0)
        if prob >= tier_threshold_high:
            safety.append(r)
        elif prob >= tier_threshold_low:
            match.append(r)
        else:
            reach.append(r)

    def _fmt_group(label: str, items: list) -> None:
        if not items:
            return
        lines.append(f"\n### {label}（{len(items)}个）")
        for r in items[:5]:
            uni = r.get("university", "")
            maj = r.get("major", "")
            prob = r.get("probability", 0)
            steps = r.get("_adjustment_steps") or []
            note = ""
            if steps:
                adjustments = [s.get("name", "") for s in steps if isinstance(s, dict) and s.get("name")]
                if adjustments:
                    note = f" [调整: {', '.join(adjustments)}]"
            lines.append(f"- {uni} {maj}：{prob:.0%}{note}")

    _fmt_group(f"保底(≥{tier_threshold_high:.0%})", safety)
    _fmt_group(f"适中({tier_threshold_low:.0%}-{tier_threshold_high:.0%})", match)
    _fmt_group(f"冲刺(<{tier_threshold_low:.0%})", reach)

    return "\n".join(lines)
